# --- Choose providers ---
# Answer generation: anthropic | ollama
LLM_PROVIDER=ollama
# Embeddings: voyage (hosted) | local (Hugging Face model running on this machine)
EMBEDDING_PROVIDER=local

# --- Anthropic (needed only when LLM_PROVIDER=anthropic) ---
# ANTHROPIC_API_KEY=sk-ant-your-key-here
# CHAT_MODEL=claude-haiku-5-5

# --- Voyage (needed only when EMBEDDING_PROVIDER=voyage) ---
# VOYAGE_API_KEY=pa-your-key-here
# EMBEDDING_MODEL defaults: voyage-3.5-lite (voyage) / Xenova/all-MiniLM-L6-v2 (local)
# EMBEDDING_MODEL=

# --- Ollama (when LLM_PROVIDER=ollama) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# --- "Most asked" list (stored in a SQLite file; survives restarts) ---
# SQLITE_PATH=./data/faq-rag.db   # 'off' disables the feature, ':memory:' keeps it in RAM only
# SQLITE_DRIVER=auto              # auto = better-sqlite3 if installed, else Node's built-in node:sqlite (Node 22.5+)
# POPULAR_LIMIT=2                 # how many to show (1-10)
# POPULAR_MIN_COUNT=1             # only show a question once it has been asked this many times

# --- Vector store: where the chunk vectors live (needs SQLite unless 'memory') ---
# VECTOR_STORE=auto               # auto / sqlite-vec: saved in SQLite, searched by the sqlite-vec extension (falls back to saved-but-searched-in-Node if it isn't installed)
#                                 # sqlite: saved in SQLite, searched in Node      memory: RAM only, re-embedded at every start

# --- Answer cache (needs SQLite): a repeated question skips retrieval and the chat model ---
# ANSWER_CACHE=on                 # on | off
# ANSWER_CACHE_TTL_HOURS=168      # saved answers expire after this long (0 = never)
# ANSWER_CACHE_MAX_ENTRIES=1000   # least recently used entries are dropped beyond this

# --- Status API (a separate process: `node --env-file=.env src/status.js`) ---
# It reads LLM_PROVIDER, OLLAMA_*, ANTHROPIC_* and PORT from above, so it checks the same app and the same LLM.
# STATUS_PORT=4000                # where the status API listens (must differ from PORT)
# APP_URL=http://127.0.0.1:3000   # the app to check; default is http://127.0.0.1:$PORT
# STATUS_TIMEOUT_MS=3000          # how long each check may take before it counts as down
# STATUS_CACHE_MS=5000            # reuse a result for this long, so polling doesn't hammer the LLM (0 = check every time)

# --- App ---
MAX_ANSWER_TOKENS=500
# Split multi-part questions into sub-questions before retrieval: auto | off | always
QUERY_DECOMPOSITION=auto
FAQ_DIR=./faqs
PORT=3000
CHUNK_SIZE=200
CHUNK_OVERLAP=30
DEFAULT_TOP_K=4
MAX_TOP_K=10
# Default: 30000 (120000 with ollama)
# REQUEST_TIME
